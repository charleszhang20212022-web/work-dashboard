# =====================================================================
#  업무 종합 대시보드 (고도화) — 환경 변수 예시
#  이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 커밋되지 않음)
#  Railway 에서는 [Variables] 탭에 동일한 키를 입력하면 됩니다.
# =====================================================================

# ---- 기본 ----
PORT=3000
# 배포 후 실제 도메인. Google OAuth 콜백 URL 계산에 사용됩니다.
# 예) https://work-dashboard-production.up.railway.app
BASE_URL=http://localhost:3000
# 세션 암호화 키 (아무 긴 임의 문자열)
SESSION_SECRET=change-this-to-a-long-random-string

# ---- 관리자 로그인 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# ---- Google 로그인 (필수 기능) ----
# Google Cloud Console > API & Services > Credentials 에서 OAuth 2.0 클라이언트 ID 생성
# 승인된 리디렉션 URI 에 다음을 추가:  <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 데이터베이스 (선택) ----
# 있으면 Postgres(JSONB)에 저장, 없으면 data/store.json 파일에 저장.
# Railway 에서 PostgreSQL 플러그인을 추가하면 자동으로 주입됩니다.
DATABASE_URL=

# ---- 일일 결산 자동 메일 (보너스) ----
# 방법 A) Gmail: 2단계 인증 후 "앱 비밀번호" 발급해서 사용
GMAIL_USER=
GMAIL_APP_PASSWORD=
# 방법 B) 일반 SMTP (Gmail 대신 사용할 경우)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# 발신자 표시 주소(선택) / 기본 수신자(선택, 쉼표 구분)
MAIL_FROM=
MAIL_DEFAULT_TO=
